# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Oracle harness: toolchains, oracle builds and run reports — regenerable from
# the pins in oracles/oracles.lock.toml (run `python oracles/harness.py build`).
/oracles/.cache/
__pycache__/
*.pyc

# The engine: CMake build trees and the project's Python virtual environment.
/build/
/.venv/
*.egg-info/
.pytest_cache/
