# The code signature of the sources that decide Hunt's ground truth (stage E9;
# engine/CMakeLists.txt, T5D_TRUTH_SOURCES): the SHA-256 of the list of each
# file's SHA-256 and path, every file read with CRLF as LF (a checkout's line
# endings do not change it). The truth's provenance records the signature of
# the build that recorded it; a build whose signature differs is told so - the
# rules engine, the prover or the recorder changed since (t5d-scan6bpp).
#
#   cmake -DROOT=<engine dir> -DFILES=<a,b,...> -DOUT=<header> -P code_signature.cmake

string(REPLACE "," ";" files "${FILES}")
set(acc "")
foreach(f IN LISTS files)
  file(READ "${ROOT}/${f}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  string(SHA256 h "${content}")
  string(APPEND acc "${h}  ${f}\n")
endforeach()
string(SHA256 sig "${acc}")
file(WRITE "${OUT}"
  "// Generated by engine/cmake/code_signature.cmake - do not edit: the code\n"
  "// signature of the sources that decide Hunt's ground truth (T5D_TRUTH_SOURCES).\n"
  "#define T5D_CODE_SIGNATURE \"sha256:${sig}\"\n")
